{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "tri-state-grants-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://atphobia22.github.io"
  },
  "d1_databases": [
    {
      "binding": "GRANTS_DB",
      "database_name": "tri-state-grant-matrix",
      "database_id": "ab4f178b-9d87-42cd-bb70-c871ea909700",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "30 15 * * *"
    ]
  }
}
