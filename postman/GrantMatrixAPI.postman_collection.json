{
  "info": {
    "name": "Tri-State Grant Matrix — Public API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Public read-only contract. No applicant data or admin secrets."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/readyz"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON',()=>pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Nine counties",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v1/counties"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON',()=>pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v1/catalog"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON',()=>pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Search grants",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v1/programs?county=18129&q=water"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON',()=>pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Federal discoveries",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v1/discover?limit=25"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON',()=>pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Audit",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v1/audits/latest?limit=25"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON',()=>pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "County sources",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v1/records?fips=21101"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON',()=>pm.response.to.be.json);"
            ]
          }
        }
      ]
    }
  ]
}
